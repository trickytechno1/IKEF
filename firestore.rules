rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public reading for community members directory
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() || resource.data.uid == request.auth.uid;
    }

    // Security & registration log
    match /registrations/{regId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Public access for vocabulary, opportunities, events
    match /vocabulary/{vocabId} {
      allow read: if true;
      allow write: if true;
    }

    match /opportunities/{oppId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
